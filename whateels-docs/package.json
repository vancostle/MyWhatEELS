{
  "name": "whateels-docs",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/generate-pages-index.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/generate-pages-index.mjs",
    "build": "ng build",
    "prebuild:ghpages": "node scripts/generate-pages-index.mjs",
    "build:ghpages": "ng build --base-href /MyWhatEELS/ && node scripts/prepare-ghpages.mjs",
    "deploy:ghpages": "npm run build:ghpages && npx angular-cli-ghpages --dir=dist/whateels-docs/browser",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:whateels-docs": "node dist/whateels-docs/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.14.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.10",
    "@emailjs/browser": "^4.4.1",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "jwt-decode": "^4.0.0",
    "ngx-markdown": "^21.3.0",
    "openai": "^6.41.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.10",
    "@angular/cli": "^21.2.10",
    "@angular/compiler-cli": "^21.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-cli-ghpages": "^3.0.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
